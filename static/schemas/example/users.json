{
  "entity": {
    "name": "user",
    "mainAttribute": "uid",
    "objectClass": ["top", "twakeAccount", "twakeWhitePages"],
    "singularName": "user",
    "pluralName": "users",
    "base": "ou=users,__ldap_base__"
  },
  "strict": true,
  "attributes": {
    "objectClass": {
      "type": "array",
      "items": {
        "type": "string",
        "test": "^[a-zA-Z][a-zA-Z0-9-]*$"
      },
      "default": ["top", "twakeAccount", "twakeWhitePages"],
      "required": true,
      "fixed": true
    },
    "uid": {
      "type": "string",
      "searchable": true,
      "test": "^[a-zA-Z0-9._-]{1,255}$",
      "required": true,
      "role": "identifier",
      "generated": true,
      "generatedFrom": {
        "attribute": "mail",
        "extract": "^([^@]+)@",
        "lowercase": true,
        "strip": "[^a-zA-Z0-9._-]",
        "onCollision": "suffix"
      }
    },
    "employeeNumber": {
      "type": "string",
      "searchable": true,
      "test": "^([A-Z0-9]{6,9}|[A-Z][A-Z0-9]{13}|UNIT)$",
      "hint": "Expected 6 to 9 characters, or a letter followed by 13 characters, or UNIT",
      "required": true,
      "unique": {
        "sentinel": "UNIT"
      },
      "role": "employeeId",
      "label": "Employee ID"
    },
    "cn": {
      "type": "string",
      "searchable": true,
      "required": true,
      "role": "displayName"
    },
    "sn": {
      "type": "string",
      "searchable": true,
      "test": "^[A-ZÀ-ÖØ-Þ](?!.*([\\s’'-]{2}|[.’'-]{2}|\\s\\.|[\\s’'-]$))[A-Za-zÀ-ÖØ-öø-ÿ\\s’'.-]{1,50}$",
      "hint": "Starts with a capital, up to 51 letters, no repeated space, apostrophe, hyphen or dot",
      "required": true,
      "label": "Last name"
    },
    "givenName": {
      "type": "string",
      "searchable": true,
      "test": "^[A-ZÀ-ÖØ-Þ](?!.*([\\s’'-]{2}|[.’'-]{2}|\\s\\.|[\\s’'-]$))[A-Za-zÀ-ÖØ-öø-ÿ\\s’'.-]{1,50}$",
      "hint": "Starts with a capital, up to 51 letters, no repeated space, apostrophe, hyphen or dot",
      "required": false,
      "label": "First name"
    },
    "displayName": {
      "type": "string",
      "required": false
    },
    "personalTitle": {
      "type": "pointer",
      "branch": ["ou=twakeTitle,ou=nomenclature,__LDAP_BASE__"],
      "required": false,
      "label": "Title"
    },
    "title": {
      "type": "pointer",
      "branch": ["ou=positions,__LDAP_BASE__"],
      "required": false,
      "referentialIntegrity": "restrict",
      "role": "position",
      "label": "Position"
    },
    "description": {
      "type": "string",
      "required": false,
      "label": "Comment"
    },
    "mail": {
      "type": "string",
      "searchable": true,
      "test": "^[^@\\s]{1,64}@example\\.org$",
      "hint": "Expected an address in the example.org domain, at most 64 characters before the @",
      "required": true,
      "unique": {
        "attributes": ["mailAlternateAddress"],
        "branches": ["__LDAP_BASE__"]
      },
      "mailDomainScope": "organization",
      "role": "primaryEmail"
    },
    "mailAlternateAddress": {
      "type": "array",
      "items": {
        "type": "string",
        "test": "^[^@\\s]{1,64}@example\\.org$",
        "hint": "Expected an address in the example.org domain, at most 64 characters before the @"
      },
      "required": false,
      "unique": {
        "attributes": ["mail"],
        "branches": ["__LDAP_BASE__"]
      },
      "mailDomainScope": "organization",
      "role": "emailAliases"
    },
    "twakeOtherMailbox": {
      "type": "array",
      "items": {
        "type": "string",
        "test": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
        "hint": "Expected an external email address"
      },
      "required": false,
      "group": "Mailbox Settings"
    },
    "mailQuotaSize": {
      "type": "number",
      "required": false,
      "role": "emailQuotaSize",
      "normalize": "byteSize",
      "default": 1000000000,
      "hint": "Expected pattern xGB, xMB, xKB or a number of bytes",
      "group": "Mailbox Settings"
    },
    "telephoneNumber": {
      "type": "string",
      "test": "^\\(\\+99\\)\\s\\d{3}\\s\\d{4}$",
      "hint": "Expected pattern (+99) 999 9999",
      "required": false,
      "label": "Phone"
    },
    "mobile": {
      "type": "string",
      "test": "^\\(\\+99\\)\\s5\\d{3}\\s\\d{4}$",
      "hint": "Expected pattern (+99) 5999 9999",
      "required": false
    },
    "postalAddress": {
      "type": "string",
      "test": "^[A-Z0-9À-ÖØ-öø-ÿ]((?!.*([-,'’()&/.]{2}|\\s{2}|\\s[,'’.)]|['’.(]\\s|\\)[^\\s]|[^\\s]\\())[a-zA-ZÀ-ÖØ-öø-ÿ0-9,\\s\\-'’()&/.])*[A-Za-zÀ-ÖØ-öø-ÿ0-9)]$",
      "hint": "Starts with a capital or a digit, no repeated punctuation, ends with a letter, a digit or )",
      "required": false,
      "label": "Address"
    },
    "postalCode": {
      "type": "string",
      "test": "^[AR1-9][0-9]{4}$",
      "hint": "Expected pattern 9999, A9999 or R9999",
      "required": false,
      "label": "Zip code"
    },
    "l": {
      "type": "string",
      "test": "^[A-Za-zÀ-ÖØ-Þ](?!.*(['’\\s-]{2}))[A-Za-zÀ-ÖØ-öø-ÿ'’\\s-]*$",
      "hint": "Letters, spaces, apostrophes and hyphens, none of them repeated",
      "required": false,
      "label": "Locality"
    },
    "userPassword": {
      "type": "string",
      "required": false,
      "role": "password",
      "neverReturn": true
    },
    "pwdReset": {
      "type": "boolean",
      "required": false,
      "role": "passwordReset",
      "neverReturn": true
    },
    "twakeDepartmentLink": {
      "type": "pointer",
      "branch": ["ou=organization,__LDAP_BASE__"],
      "required": true,
      "role": "organizationLink",
      "label": "Department"
    },
    "twakeDepartmentPath": {
      "type": "string",
      "test": "^[^\\r\\n]{1,4096}$",
      "required": true,
      "generated": true,
      "role": "organizationPath"
    },
    "twakeAccountStatus": {
      "type": "pointer",
      "branch": ["ou=twakeAccountStatus,ou=nomenclature,__LDAP_BASE__"],
      "required": true,
      "generated": true,
      "role": "accountStatus",
      "default": "cn=active,ou=twakeAccountStatus,ou=nomenclature,__LDAP_BASE__",
      "states": {
        "enabled": "cn=active,ou=twakeAccountStatus,ou=nomenclature,__LDAP_BASE__",
        "disabled": "cn=disabled,ou=twakeAccountStatus,ou=nomenclature,__LDAP_BASE__",
        "noAccess": "cn=noaccess,ou=twakeAccountStatus,ou=nomenclature,__LDAP_BASE__",
        "toDelete": "cn=todelete,ou=twakeAccountStatus,ou=nomenclature,__LDAP_BASE__"
      }
    },
    "twakeDeliveryMode": {
      "type": "array",
      "items": {
        "type": "pointer",
        "branch": ["ou=twakeDeliveryMode,ou=nomenclature,__LDAP_BASE__"]
      },
      "required": false,
      "readOnly": true,
      "group": "Mailbox Settings"
    },
    "twakeDeletionDate": {
      "type": "date",
      "required": false,
      "role": "accountExpiry",
      "hint": "Expected pattern MM/DD/YYYY, not earlier than today",
      "label": "Deletion date"
    },
    "memberOf": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false,
      "readOnly": true,
      "role": "groupMemberships",
      "label": "Mailing lists"
    }
  }
}
