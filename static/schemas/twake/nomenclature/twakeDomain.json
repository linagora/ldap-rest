{
  "entity": {
    "name": "twakeDomain",
    "mainAttribute": "dc",
    "objectClass": ["top", "domain", "domainRelatedObject"],
    "singularName": "domain",
    "pluralName": "domains",
    "base": "ou=domains,ou=nomenclature,{ldap_base}",
    "label": {
      "en": "Mail domains",
      "fr": "Domaines de messagerie",
      "mn": "Имэйлийн домэйнууд"
    },
    "singularLabel": {
      "en": "domain",
      "fr": "domaine",
      "mn": "домэйн"
    }
  },
  "strict": true,
  "attributes": {
    "objectClass": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": ["top", "domain", "domainRelatedObject"],
      "required": true,
      "fixed": true
    },
    "dc": {
      "type": "string",
      "test": "^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$",
      "hint": {
        "en": "A single domain label: letters, digits and hyphens, e.g. example",
        "fr": "Un seul élément de nom de domaine : lettres, chiffres et tirets, par ex. example",
        "mn": "Домэйн нэрийн нэг хэсэг: үсэг, тоо болон зураас, жишээ нь example"
      },
      "required": true,
      "role": "identifier",
      "label": {
        "en": "Identifier",
        "fr": "Identifiant",
        "mn": "Тодорхойлогч"
      }
    },
    "associatedDomain": {
      "type": "string",
      "test": "^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$|^\\*$",
      "hint": {
        "en": "A fully qualified domain name (example.org), or * to allow every domain",
        "fr": "Un nom de domaine complet (example.org), ou * pour autoriser tous les domaines",
        "mn": "Бүтэн домэйн нэр (example.org), эсвэл бүх домэйныг зөвшөөрөх бол *"
      },
      "required": true,
      "role": ["domainName", "displayName"],
      "label": {
        "en": "Mail domain",
        "fr": "Domaine de messagerie",
        "mn": "Имэйлийн домэйн"
      }
    },
    "description": {
      "type": "string",
      "required": false,
      "label": {
        "en": "Description",
        "fr": "Description",
        "mn": "Тайлбар"
      }
    }
  }
}
