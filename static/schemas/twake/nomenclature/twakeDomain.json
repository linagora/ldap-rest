{
  "entity": {
    "name": "twakeDomain",
    "mainAttribute": "dc",
    "objectClass": ["top", "domain", "domainRelatedObject"],
    "singularName": "domain",
    "pluralName": "domains",
    "base": "ou=domains,ou=nomenclature,{ldap_base}",
    "label": {
      "en": "Mail domains",
      "fr": "Domaines de messagerie"
    },
    "singularLabel": {
      "en": "domain",
      "fr": "domaine"
    }
  },
  "strict": true,
  "attributes": {
    "objectClass": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": ["top", "domain", "domainRelatedObject"],
      "required": true,
      "fixed": true
    },
    "dc": {
      "type": "string",
      "test": "^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$",
      "hint": "A single domain label: letters, digits and hyphens, e.g. example",
      "required": true,
      "role": "identifier",
      "label": {
        "en": "dc",
        "fr": "Identifiant"
      }
    },
    "associatedDomain": {
      "type": "string",
      "test": "^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$|^\\*$",
      "hint": "A fully qualified domain name (example.org), or * to allow every domain",
      "required": true,
      "role": "domainName",
      "label": {
        "en": "Mail domain",
        "fr": "Domaine de messagerie"
      }
    },
    "description": {
      "type": "string",
      "required": false,
      "label": {
        "en": "description",
        "fr": "Description"
      }
    }
  }
}
