      },
      "default": ["top", "organizationalUnit", "twakeDepartment"],
      "required": true,
      "fixed": true
    },
    "ou": {
      "type": "string",
      "searchable": true,
      "test": "^[A-Za-zÀ-ÖØ-öø-ÿ0-9][A-Za-zÀ-ÖØ-öø-ÿ0-9 ()&/,.'’_-]{0,254}$",
      "hint": {
        "en": "Letters, digits, spaces and ( ) & / , . ' - _, starting with a letter or a digit",
        "fr": "Lettres, chiffres, espaces et ( ) & / , . ' - _, en commençant par une lettre ou un chiffre",
        "mn": "Үсэг, тоо, зай болон ( ) & / , . ' - _, үсэг эсвэл тоогоор эхэлнэ"
      },
      "required": true,
      "unique": true,
      "role": "identifier",
      "label": {
        "en": "Name",
        "fr": "Nom",
        "mn": "Нэр"
      }
    },
    "description": {
      "type": "string",
      "searchable": true,
      "required": false,
      "label": {
        "en": "Description",
        "fr": "Description",
        "mn": "Тайлбар"
      }
    },
    "telephoneNumber": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false,
      "label": {
        "en": "Phone",
        "fr": "Téléphone",
        "mn": "Утас"
      }
    },
    "facsimileTelephoneNumber": {
      "type": "string",
      "required": false,
      "label": {
        "en": "Fax",
        "fr": "Fax",
        "mn": "Факс"
      }
    },
    "l": {
      "type": "string",
      "required": false,
      "label": {
        "en": "Locality",
        "fr": "Commune",
        "mn": "Суурин газар"
      }
    },
    "postalAddress": {
      "type": "string",
      "required": false,
      "label": {
        "en": "Address",
        "fr": "Adresse",
        "mn": "Хаяг"
      }
    },
    "twakeDepartmentPath": {
      "type": "string",
      "test": "^[^\\r\\n]{1,4096}$",
