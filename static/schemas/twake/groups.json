{
  "entity": {
    "name": "twakeGroup",
    "mainAttribute": "cn",
    "objectClass": ["top", "groupOfNames", "twakeStaticGroup"],
    "singularName": "group",
    "pluralName": "groups",
    "base": "ou=groups,__ldap_base__",
    "label": {
      "en": "Groups",
      "fr": "Groupes"
    },
    "singularLabel": {
      "en": "group",
      "fr": "groupe"
    }
  },
  "strict": true,
  "attributes": {
    "objectClass": {
      "type": "array",
      "items": {
        "type": "string",
        "test": "^[a-zA-Z][a-zA-Z0-9-]*$"
      },
      "default": ["top", "groupOfNames", "twakeStaticGroup"],
      "required": true,
      "fixed": true
    },
    "cn": {
      "type": "string",
      "searchable": true,
      "test": "^(?!.*\\.\\.)[a-zA-Z0-9!#$%&'*+/=?^_`{|}.-]{1,64}$",
      "hint": {
        "en": "Must match an email local part: letters, digits and ! # $ % & ' * + / = ? ^ _ ` { | } . -, no consecutive dots",
        "fr": "Partie locale d'une adresse électronique : lettres, chiffres et ! # $ % & ' * + / = ? ^ _ ` { | } . -, sans points consécutifs"
      },
      "required": true,
      "role": "identifier",
      "label": {
        "en": "Name",
        "fr": "Nom"
      }
    },
    "description": {
      "type": "string",
      "searchable": true,
      "required": false,
      "label": {
        "en": "Description",
        "fr": "Description"
      }
    },
    "mail": {
      "type": "string",
      "searchable": true,
      "test": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "hint": {
        "en": "Expected an email address, e.g. all-staff@lists.example.org",
        "fr": "Une adresse électronique est attendue, par ex. all-staff@lists.example.org"
      },
      "required": false,
      "unique": {
        "attributes": ["mailAlternateAddress"],
        "branches": ["__LDAP_BASE__"]
      },
      "mailDomainScope": "organization",
      "allowSubdomains": true,
      "role": "primaryEmail",
      "label": {
        "en": "Email",
        "fr": "Adresse électronique"
      }
    },
    "businessCategory": {
      "type": "pointer",
      "branch": ["ou=twakeListType,ou=nomenclature,__LDAP_BASE__"],
      "required": false,
      "role": "writePolicy",
      "label": {
        "en": "List type",
        "fr": "Type de liste"
      },
      "group": {
        "en": "Mailbox Settings",
        "fr": "Paramètres de messagerie"
      }
    },
    "twakeMailboxType": {
      "type": "pointer",
      "branch": ["ou=twakeMailboxType,ou=nomenclature,__LDAP_BASE__"],
      "group": {
        "en": "Mailbox Settings",
        "fr": "Paramètres de messagerie"
      },
      "required": false,
      "role": "mailboxType",
      "label": {
        "en": "Group type",
        "fr": "Type de groupe"
      }
    },
    "member": {
      "type": "array",
      "items": {
        "type": "string",
        "test": "^[a-zA-Z]+=.*,__LDAP_BASE__$",
        "hint": {
          "en": "Expected the DN of an entry of this directory",
          "fr": "Le DN d'une entrée de cet annuaire est attendu"
        }
      },
      "required": false,
      "role": "members",
      "label": {
        "en": "Members",
        "fr": "Membres"
      }
    },
    "owner": {
      "type": "array",
      "items": {
        "type": "string",
        "test": "^[a-zA-Z]+=.*,__LDAP_BASE__$",
        "hint": {
          "en": "Expected the DN of an entry of this directory",
          "fr": "Le DN d'une entrée de cet annuaire est attendu"
        }
      },
      "required": false,
      "role": "owners",
      "label": {
        "en": "Owners",
        "fr": "Propriétaires"
      }
    },
    "twakeDepartmentLink": {
      "type": "pointer",
      "branch": ["__LDAP_BASE__"],
      "required": true,
      "role": "organizationLink",
      "label": {
        "en": "Department",
        "fr": "Organisation"
      }
    },
    "twakeDepartmentPath": {
      "type": "string",
      "test": "^[^\\r\\n]{1,4096}$",
      "required": true,
      "generated": true,
      "role": "organizationPath",
      "label": {
        "en": "Department path",
        "fr": "Chemin"
      }
    }
  }
}
