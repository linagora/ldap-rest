{
  "entity": {
    "name": "twakeUser",
    "mainAttribute": "uid",
    "objectClass": ["top", "twakeAccount", "twakeWhitePages"],
    "singularName": "user",
    "pluralName": "users",
    "base": "ou=users,__ldap_base__",
    "label": {
      "en": "Users",
      "fr": "Utilisateurs",
      "mn": "Хэрэглэгчид"
    },
    "singularLabel": {
      "en": "user",
      "fr": "utilisateur",
      "mn": "хэрэглэгч"
    }
  },
  "strict": true,
  "attributes": {
    "objectClass": {
      "type": "array",
      "items": {
        "type": "string",
        "test": "^[a-zA-Z][a-zA-Z0-9-]*$"
      },
      "default": ["top", "twakeAccount", "twakeWhitePages"],
      "required": true,
      "fixed": true
    },
    "uid": {
      "type": "string",
      "searchable": true,
      "test": "^[a-zA-Z0-9._-]{1,255}$",
      "required": true,
      "role": "identifier",
      "generated": true,
      "generatedFrom": {
        "attribute": "mail",
        "extract": "^([^@]+)@",
        "lowercase": true,
        "strip": "[^a-zA-Z0-9._-]",
        "onCollision": "suffix"
      },
      "label": {
        "en": "Identifier",
        "fr": "Identifiant",
        "mn": "Нэвтрэх нэр"
      }
    },
    "employeeNumber": {
      "type": "string",
      "searchable": true,
      "required": true,
      "unique": {
        "sentinel": "UNIT"
      },
      "role": "employeeId",
      "label": {
        "en": "Employee ID",
        "fr": "Matricule",
        "mn": "Ажилтны дугаар"
      },
      "help": {
        "en": "The person's registration number, as the personnel records hold it. Unique in the directory, except UNIT, which the accounts of no one in particular (shared, technical) take.",
        "fr": "Le matricule de la personne, tel que le tient la gestion du personnel. Unique dans l'annuaire, sauf UNIT, que prennent les comptes qui ne sont à personne en particulier (partagés, techniques).",
        "mn": "Хүний нөөцийн бүртгэлд байгаа ажилтны дугаар. Лавлахад давхцахгүй байх ёстой; хэн нэгэн хүнд хамааралгүй (дундын, техникийн) бүртгэлүүд UNIT утгыг авна."
      }
    },
    "twakeDepartmentLink": {
      "type": "pointer",
      "branch": ["__LDAP_BASE__"],
      "required": true,
      "role": "organizationLink",
      "label": {
        "en": "Department",
        "fr": "Organisation",
        "mn": "Байгууллага"
      }
    },
    "cn": {
      "type": "string",
      "searchable": true,
      "required": false,
      "label": {
        "en": "Common name",
        "fr": "Nom d'annuaire",
        "mn": "Лавлахын нэр"
      }
    },
    "sn": {
      "type": "string",
      "searchable": true,
      "required": true,
      "role": "surname",
      "label": {
        "en": "Last name",
        "fr": "Nom de famille",
        "mn": "Овог"
      }
    },
    "givenName": {
      "type": "string",
      "searchable": true,
      "required": true,
      "role": "givenName",
      "label": {
        "en": "First name",
        "fr": "Prénom",
        "mn": "Нэр"
      }
    },
    "displayName": {
      "type": "string",
      "role": "displayName",
      "required": true,
      "label": {
        "en": "Full name",
        "fr": "Nom complet",
        "mn": "Бүтэн нэр"
      }
    },
    "personalTitle": {
      "type": "pointer",
      "branch": ["ou=twakeTitle,ou=nomenclature,__LDAP_BASE__"],
      "referentialIntegrity": "restrict",
      "required": false,
      "label": {
        "en": "Title",
        "fr": "Civilité",
        "mn": "Хандах хэлбэр"
      }
    },
    "title": {
      "type": "pointer",
      "branch": ["ou=positions,__LDAP_BASE__"],
      "required": false,
      "referentialIntegrity": "restrict",
      "role": "position",
      "label": {
        "en": "Position",
        "fr": "Poste",
        "mn": "Албан тушаал"
      }
    },
    "description": {
      "type": "string",
      "required": false,
      "label": {
        "en": "Comment",
        "fr": "Commentaire",
        "mn": "Тэмдэглэл"
      }
    },
    "mail": {
      "type": "string",
      "searchable": true,
      "test": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "hint": {
        "en": "Expected an email address, e.g. jane.doe@example.org",
        "fr": "Une adresse électronique est attendue, par ex. jane.doe@example.org",
        "mn": "Имэйл хаяг оруулна уу, жишээ нь jane.doe@example.org"
      },
      "required": true,
      "unique": {
        "attributes": ["mailAlternateAddress"],
        "branches": ["__LDAP_BASE__"]
      },
      "mailDomainScope": "organization",
      "role": "primaryEmail",
      "label": {
        "en": "Email",
        "fr": "Adresse électronique",
        "mn": "Имэйл хаяг"
      }
    },
    "mailAlternateAddress": {
      "type": "array",
      "items": {
        "type": "string",
        "test": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
        "hint": {
          "en": "Expected an email address, e.g. jane.doe@example.org",
          "fr": "Une adresse électronique est attendue, par ex. jane.doe@example.org",
          "mn": "Имэйл хаяг оруулна уу, жишээ нь jane.doe@example.org"
        }
      },
      "required": false,
      "unique": {
        "attributes": ["mail"],
        "branches": ["__LDAP_BASE__"]
      },
      "mailDomainScope": "organization",
      "role": "emailAliases",
      "label": {
        "en": "Email aliases",
        "fr": "Alias",
        "mn": "Нэмэлт имэйл хаягууд"
      }
    },
    "twakeOtherMailbox": {
      "type": "array",
      "items": {
        "type": "string",
        "test": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
        "hint": {
          "en": "Expected an email address, e.g. jane.doe@example.org",
          "fr": "Une adresse électronique est attendue, par ex. jane.doe@example.org",
          "mn": "Имэйл хаяг оруулна уу, жишээ нь jane.doe@example.org"
        }
      },
      "required": false,
      "group": {
        "en": "Mailbox Settings",
        "fr": "Paramètres de messagerie",
        "mn": "Шуудангийн хайрцгийн тохиргоо"
      },
      "label": {
        "en": "Other mailboxes",
        "fr": "Autres boîtes",
        "mn": "Бусад шуудангийн хайрцаг"
      }
    },
    "mailQuotaSize": {
      "type": "number",
      "required": false,
      "role": "emailQuotaSize",
      "normalize": "byteSize",
      "hint": {
        "en": "Expected pattern xGB, xMB, xKB or a number of bytes",
        "fr": "Format attendu : xGB, xMB, xKB ou un nombre d'octets",
        "mn": "Хэлбэр: xGB, xMB, xKB эсвэл байтын тоо"
      },
      "group": {
        "en": "Mailbox Settings",
        "fr": "Paramètres de messagerie",
        "mn": "Шуудангийн хайрцгийн тохиргоо"
      },
      "label": {
        "en": "Mailbox size",
        "fr": "Taille de boîte",
        "mn": "Шуудангийн хайрцгийн хэмжээ"
      }
    },
    "telephoneNumber": {
      "type": "string",
      "required": false,
      "label": {
        "en": "Phone",
        "fr": "Téléphone",
        "mn": "Утас"
      }
    },
    "mobile": {
      "type": "string",
      "required": false,
      "label": {
        "en": "Mobile",
        "fr": "Mobile",
        "mn": "Гар утас"
      }
    },
    "postalAddress": {
      "type": "string",
      "required": false,
      "label": {
        "en": "Address",
        "fr": "Adresse",
        "mn": "Хаяг"
      }
    },
    "postalCode": {
      "type": "string",
      "required": false,
      "label": {
        "en": "Zip code",
        "fr": "Code postal",
        "mn": "Шуудангийн код"
      }
    },
    "l": {
      "type": "string",
      "required": false,
      "label": {
        "en": "Locality",
        "fr": "Commune",
        "mn": "Суурин газар"
      }
    },
    "userPassword": {
      "type": "string",
      "required": false,
      "role": "password",
      "neverReturn": true,
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "mn": "Нууц үг"
      }
    },
    "pwdReset": {
      "type": "boolean",
      "required": false,
      "role": "passwordReset",
      "neverReturn": true,
      "label": {
        "en": "Password reset required",
        "fr": "Changement de mot de passe requis",
        "mn": "Нууц үгээ солих шаардлагатай"
      }
    },
    "twakeDepartmentPath": {
      "type": "string",
      "test": "^[^\\r\\n]{1,4096}$",
      "required": true,
      "generated": true,
      "role": "organizationPath",
      "label": {
        "en": "Department path",
        "fr": "Chemin",
        "mn": "Зам"
      }
    },
    "twakeAccountStatus": {
      "type": "pointer",
      "branch": ["ou=twakeAccountStatus,ou=nomenclature,__LDAP_BASE__"],
      "referentialIntegrity": "restrict",
      "required": true,
      "generated": true,
      "role": "accountStatus",
      "default": "cn=active,ou=twakeAccountStatus,ou=nomenclature,__LDAP_BASE__",
      "states": {
        "enabled": "cn=active,ou=twakeAccountStatus,ou=nomenclature,__LDAP_BASE__",
        "disabled": "cn=disabled,ou=twakeAccountStatus,ou=nomenclature,__LDAP_BASE__",
        "noAccess": "cn=noaccess,ou=twakeAccountStatus,ou=nomenclature,__LDAP_BASE__",
        "toDelete": "cn=todelete,ou=twakeAccountStatus,ou=nomenclature,__LDAP_BASE__"
      },
      "label": {
        "en": "Status",
        "fr": "État",
        "mn": "Төлөв"
      }
    },
    "twakeDeliveryMode": {
      "type": "array",
      "items": {
        "type": "pointer",
        "branch": ["ou=twakeDeliveryMode,ou=nomenclature,__LDAP_BASE__"]
      },
      "referentialIntegrity": "restrict",
      "required": true,
      "generated": true,
      "default": [
        "cn=normal,ou=twakeDeliveryMode,ou=nomenclature,__LDAP_BASE__"
      ],
      "group": {
        "en": "Mailbox Settings",
        "fr": "Paramètres de messagerie",
        "mn": "Шуудангийн хайрцгийн тохиргоо"
      },
      "label": {
        "en": "Delivery mode",
        "fr": "Mode de distribution",
        "mn": "Хүргэлтийн горим"
      }
    },
    "twakeDeletionDate": {
      "type": "date",
      "required": false,
      "role": "accountExpiry",
      "hint": {
        "en": "Expected a date not earlier than today",
        "fr": "Une date à partir d'aujourd'hui est attendue",
        "mn": "Өнөөдөр эсвэл түүнээс хойших огноо оруулна уу"
      },
      "label": {
        "en": "Deletion date",
        "fr": "Date de suppression",
        "mn": "Устгах огноо"
      }
    },
    "twakeDelegatedUsers": {
      "type": "array",
      "items": {
        "type": "pointer",
        "branch": ["ou=users,__LDAP_BASE__"]
      },
      "required": false,
      "referentialIntegrity": "remove",
      "group": {
        "en": "Mailbox Settings",
        "fr": "Paramètres de messagerie",
        "mn": "Шуудангийн хайрцгийн тохиргоо"
      },
      "label": {
        "en": "Delegates",
        "fr": "Délégués",
        "mn": "Төлөөлөгчид"
      }
    },
    "memberOf": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false,
      "readOnly": true,
      "role": "groupMemberships",
      "label": {
        "en": "Mailing lists",
        "fr": "Listes de diffusion",
        "mn": "Имэйл жагсаалтууд"
      }
    }
  }
}
