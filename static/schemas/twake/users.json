{
  "entity": {
    "name": "twakeUser",
    "mainAttribute": "uid",
    "objectClass": ["top", "twakeAccount", "twakeWhitePages"],
    "singularName": "user",
    "pluralName": "users",
    "base": "ou=users,__ldap_base__"
  },
  "strict": true,
  "attributes": {
    "objectClass": {
      "type": "array",
      "items": {
        "type": "string",
        "test": "^[a-zA-Z][a-zA-Z0-9-]*$"
      },
      "default": ["top", "twakeAccount", "twakeWhitePages"],
      "required": true,
      "fixed": true
    },
    "uid": {
      "type": "string",
      "test": "^[a-zA-Z0-9._-]{1,255}$",
      "required": true,
      "role": "identifier",
      "generated": true,
      "generatedFrom": {
        "attribute": "mail",
        "extract": "^([^@]+)@",
        "lowercase": true,
        "strip": "[^a-zA-Z0-9._-]",
        "onCollision": "suffix"
      }
    },
    "employeeNumber": {
      "type": "string",
      "required": false,
      "unique": true,
      "role": "employeeId",
      "label": "Employee ID"
    },
    "cn": {
      "type": "string",
      "required": true,
      "role": "displayName"
    },
    "sn": {
      "type": "string",
      "required": true
    },
    "givenName": {
      "type": "string",
      "required": false
    },
    "displayName": {
      "type": "string",
      "required": false
    },
    "personalTitle": {
      "type": "pointer",
      "branch": ["ou=twakeTitle,ou=nomenclature,__LDAP_BASE__"],
      "required": false,
      "label": "Title"
    },
    "title": {
      "type": "pointer",
      "branch": ["ou=positions,__LDAP_BASE__"],
      "required": false,
      "referentialIntegrity": "restrict",
      "role": "position",
      "label": "Position"
    },
    "description": {
      "type": "string",
      "required": false,
      "label": "Comment"
    },
    "mail": {
      "type": "string",
      "test": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "hint": "Expected an email address, e.g. jane.doe@example.org",
      "required": true,
      "unique": {
        "attributes": ["mailAlternateAddress"],
        "branches": ["__LDAP_BASE__"]
      },
      "mailDomainScope": "organization",
      "role": "primaryEmail"
    },
    "mailAlternateAddress": {
      "type": "array",
      "items": {
        "type": "string",
        "test": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
        "hint": "Expected an email address, e.g. jane.doe@example.org"
      },
      "required": false,
      "unique": {
        "attributes": ["mail"],
        "branches": ["__LDAP_BASE__"]
      },
      "mailDomainScope": "organization",
      "role": "emailAliases"
    },
    "twakeOtherMailbox": {
      "type": "array",
      "items": {
        "type": "string",
        "test": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
        "hint": "Expected an email address, e.g. jane.doe@example.org"
      },
      "required": false,
      "group": "Mailbox Settings"
    },
    "mailQuota": {
      "type": "number",
      "required": false,
      "role": "emailQuota",
      "group": "Mailbox Settings"
    },
    "mailQuotaSize": {
      "type": "number",
      "required": false,
      "role": "emailQuotaSize",
      "normalize": "byteSize",
      "hint": "Expected pattern xGB, xMB, xKB or a number of bytes",
      "group": "Mailbox Settings"
    },
    "telephoneNumber": {
      "type": "string",
      "required": false
    },
    "mobile": {
      "type": "string",
      "required": false
    },
    "postalAddress": {
      "type": "string",
      "required": false
    },
    "postalCode": {
      "type": "string",
      "required": false
    },
    "l": {
      "type": "string",
      "required": false,
      "label": "Locality"
    },
    "userPassword": {
      "type": "string",
      "required": false,
      "role": "password",
      "neverReturn": true
    },
    "pwdReset": {
      "type": "boolean",
      "required": false,
      "role": "passwordReset",
      "neverReturn": true
    },
    "twakeDepartmentLink": {
      "type": "pointer",
      "branch": ["__LDAP_BASE__"],
      "required": true,
      "role": "organizationLink"
    },
    "twakeDepartmentPath": {
      "type": "string",
      "test": "^[^\\r\\n]{1,4096}$",
      "required": true,
      "generated": true,
      "role": "organizationPath"
    },
    "twakeAccountStatus": {
      "type": "pointer",
      "branch": ["ou=twakeAccountStatus,ou=nomenclature,__LDAP_BASE__"],
      "required": true,
      "generated": true,
      "role": "accountStatus",
      "default": "cn=active,ou=twakeAccountStatus,ou=nomenclature,__LDAP_BASE__",
      "states": {
        "enabled": "cn=active,ou=twakeAccountStatus,ou=nomenclature,__LDAP_BASE__",
        "disabled": "cn=disabled,ou=twakeAccountStatus,ou=nomenclature,__LDAP_BASE__",
        "noAccess": "cn=noaccess,ou=twakeAccountStatus,ou=nomenclature,__LDAP_BASE__",
        "toDelete": "cn=todelete,ou=twakeAccountStatus,ou=nomenclature,__LDAP_BASE__"
      }
    },
    "twakeDeliveryMode": {
      "type": "array",
      "items": {
        "type": "pointer",
        "branch": ["ou=twakeDeliveryMode,ou=nomenclature,__LDAP_BASE__"]
      },
      "required": false,
      "readOnly": true,
      "group": "Mailbox Settings"
    },
    "twakeDeletionDate": {
      "type": "date",
      "required": false,
      "role": "accountExpiry",
      "hint": "Expected a date not earlier than today"
    },
    "twakeDelegatedUsers": {
      "type": "array",
      "items": {
        "type": "pointer",
        "branch": ["ou=users,__LDAP_BASE__"]
      },
      "required": false,
      "group": "Mailbox Settings"
    },
    "memberOf": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false,
      "readOnly": true,
      "role": "groupMemberships"
    }
  }
}
