{
  "strict": true,
  "entity": {
    "name": "falsyPerson",
    "mainAttribute": "uid",
    "objectClass": ["top", "inetOrgPerson"],
    "singularName": "falsyPerson",
    "pluralName": "falsyPeople",
    "base": "ou=users,__LDAP_BASE__"
  },
  "attributes": {
    "objectClass": {
      "type": "array",
      "required": true,
      "default": ["top", "inetOrgPerson"]
    },
    "uid": { "type": "string", "required": true },
    "cn": { "type": "string", "required": true },
    "sn": { "type": "string", "required": true },
    "mail": { "type": "string", "test": "^[^@\\s]+@[^@\\s]+$" },
    "employeeNumber": { "type": "string", "test": "^[1-9][0-9]*$" },
    "manager": { "type": "pointer", "branch": ["ou=users,__LDAP_BASE__"] }
  }
}
