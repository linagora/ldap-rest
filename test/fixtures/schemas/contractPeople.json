{
  "strict": true,
  "entity": {
    "name": "contractPerson",
    "mainAttribute": "uid",
    "objectClass": ["top", "inetOrgPerson", "extensibleObject"],
    "singularName": "contractPerson",
    "pluralName": "contractPeople",
    "base": "ou=users,__LDAP_BASE__"
  },
  "attributes": {
    "objectClass": {
      "type": "array",
      "items": {
