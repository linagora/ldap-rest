{
  "all": true,
  "src": [
    "src",
    "packages/auth-crowdsec/src",
    "packages/auth-fake/src",
    "packages/auth-hmac/src",
    "packages/auth-llng/src",
    "packages/auth-openidconnect/src",
    "packages/auth-ratelimit/src",
    "packages/auth-token/src",
    "packages/auth-totp/src",
    "packages/auth-trustedproxy/src",
    "packages/authz-dynamic/src",
    "packages/authz-linid1/src",
    "packages/authz-perbranch/src",
    "packages/authz-perroute/src",
    "packages/authz-scope/src",
    "packages/core/src",
    "packages/storage/src"
  ],
  "extension": [".ts"],
  "reporter": ["text-summary", "html", "lcov"],
  "report-dir": "coverage",
  "exclude": [
    "**/*.d.ts",
    "src/hooks.ts",
    "src/config/schema.ts",
    "src/**/types.ts",
    "src/browser/shared/types/index.ts",
    "packages/core/src/hooks.ts",
    "packages/core/src/config/schema.ts",
    "packages/core/src/**/types.ts",
    "test/**",
    "dist/**"
  ],
  "skip-full": false
}
