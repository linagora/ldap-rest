{
  "name": "ldap-rest-monorepo",
  "private": true,
  "description": "LDAP-Rest and its @ldap-rest packages",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "audit:directory": "tsx scripts/audit-directory.ts",
    "audit:prod": "tsx scripts/audit-prod.ts",
    "build": "npm run build:prod",
    "build:assets": "node scripts/composeAssets.mjs",
    "build:dev": "./.dev.mk builddev",
    "build:docker": "./.dev.mk builddocker",
    "build:dockerfile": "./.dev.mk Dockerfile",
    "build:packages": "node scripts/packages.mjs build",
    "build:pages": "tsx scripts/build-pages.ts",
    "build:prod": "npm run clean && npm run build:packages && npm run build:assets && npm run build:dockerfile",
    "build:watch": "npm run watch -w ldap-rest",
    "check": "npm run check:ts && npm run check:packages && npm run lint && npm run format:check && npm run check:hooks && npm run check:comments && npm run check:no-client-values && npm run check:api && npm run check:openapi && npm run check:options",
    "check:api": "npm run build:packages && tsx scripts/api-snapshot.ts --check",
    "check:comments": "sh scripts/check-comments.sh",
    "check:declarations": "tsx scripts/check-declarations.ts",
    "check:hooks": "tsx scripts/hooks-doc.ts",
    "check:no-client-values": "sh scripts/check-no-client-values.sh",
    "check:openapi": "tsx scripts/check-openapi.ts",
    "check:options": "tsx scripts/options-snapshot.ts --check",
    "check:packages": "node scripts/packages.mjs check",
    "check:ts": "node ./node_modules/typescript/bin/tsc --noEmit",
    "check:ts7": "node ./node_modules/typescript7/bin/tsc --noEmit",
    "clean": "rimraf dist static packages/*/dist packages/ldap-rest/static packages/browser/static coverage",
    "coverage": "c8 --config .c8rc.json mocha",
    "coverage:check": "npm run check:ts && c8 --config .c8rc.json --exclude 'packages/browser/src/**' --check-coverage --statements 84 --lines 84 --branches 75 --functions 86 mocha",
    "dev": "npm run start:dev",
    "fix": "npm run lint:fix && npm run format:fix",
    "format:check": "prettier --check .",
    "format:check-diff": "prettier --check $(git diff $(git rev-parse --abbrev-ref --symbolic-full-name @{u}) --name-status|grep -E '^M|A'|cut -f2)",
    "format:fix": "prettier --write .",
    "format:fix-diff": "prettier --write $(git checkout|grep -E '^(M|A)'|cut -f2)",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx,js,jsx}\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"packages/*/src/**/*.{ts,tsx,js,jsx}\" \"test/**/*.ts\" --fix",
    "snapshot:api": "npm run build:packages && tsx scripts/api-snapshot.ts",
    "snapshot:options": "tsx scripts/options-snapshot.ts",
    "start:dev": "./.dev.mk start",
    "sync:packages": "node scripts/packages.mjs sync",
    "test": "npm run check:ts && mocha",
    "test:dev": "./.dev.mk test",
    "test:one": "mocha --config .mocharc-one.json"
  },
  "overrides": {
    "@microsoft/api-extractor": {
      "minimatch": "^11.0.5"
    },
    "diff": ">=8.0.3",
    "glob": ">=11.1.0",
    "minimatch": "^10.2.3",
    "postcss-selector-parser": "^7.1.6",
    "serialize-javascript": ">=7.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/chai": "^5.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "c8": "^12.0.0",
    "chai": "^6.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.13.0",
    "js-yaml": "^5.5.0",
    "mocha": "^12.0.0",
    "nock": "^14.0.10",
    "prettier": "^3.9.10",
    "rimraf": "^6.0.1",
    "rollup": "^4.50.2",
    "rollup-plugin-postcss": "^4.0.2",
    "sort-package-json": "^4.1.0",
    "supertest": "^7.1.4",
    "tinyglobby": "^0.2.17",
    "tslib": "^2.8.1",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3",
    "typescript7": "npm:typescript@^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
