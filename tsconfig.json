{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@ldap-rest/core": ["./packages/core/src/index.ts"],
      "@ldap-rest/core/*": ["./packages/core/src/*"]
    },
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["node", "mocha"]
  },
  "include": ["src/**/*", "packages/core/src/types/**/*.d.ts", "test/**/*"],
  "exclude": ["node_modules", "dist", "packages/*/dist"]
}
