{
  "name": "@ldap-rest/storage",
  "version": "3.0.0",
  "description": "LDAP-Rest keyed storage plugin",
  "homepage": "https://github.com/linagora/ldap-rest",
  "bugs": {
    "url": "https://github.com/linagora/ldap-rest/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linagora/ldap-rest.git",
    "directory": "packages/storage"
  },
  "license": "AGPL-3.0",
  "author": "Xavier Guimard <xguimard@linagora.com>",
  "type": "module",
  "exports": {
    ".": {
