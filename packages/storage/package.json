    "@ldap-rest/storage-valkey": "3.0.0"
  },
  "peerDependenciesMeta": {
    "@ldap-rest/storage-file": {
      "optional": true
    },
    "@ldap-rest/storage-ldap": {
      "optional": true
    },
    "@ldap-rest/storage-postgres": {
      "optional": true
    },
    "@ldap-rest/storage-valkey": {
      "optional": true
    }
  }
