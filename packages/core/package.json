{
  "name": "@ldap-rest/core",
  "version": "3.0.0",
  "description": "LDAP-Rest core: the server, its hooks and the shared services",
  "homepage": "https://github.com/linagora/ldap-rest",
  "bugs": {
    "url": "https://github.com/linagora/ldap-rest/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linagora/ldap-rest.git",
    "directory": "packages/core"
  },
  "license": "AGPL-3.0",
  "author": "Xavier Guimard <xguimard@linagora.com>",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./config/priority.json": {
      "development": "./src/config/priority.json",
      "default": "./dist/config/priority.json"
    },
    "./lib/entities": {
      "development": "./src/lib/entities/index.ts",
      "types": "./dist/lib/entities/index.d.ts",
      "import": "./dist/lib/entities/index.js"
    },
    "./lib/services": {
      "development": "./src/lib/services/index.ts",
      "types": "./dist/lib/services/index.d.ts",
      "import": "./dist/lib/services/index.js"
    },
    "./bin": {
      "development": "./src/bin/index.ts",
      "types": "./dist/bin/index.d.ts",
      "import": "./dist/bin/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@sinclair/typebox": "^0.34.52",
    "body-parser": "^2.2.0",
    "express": "^5.1.0",
    "ldapts": "^9.2.0",
    "lru-cache": "^11.2.2",
    "p-limit": "^7.1.1",
    "prom-client": "^15.1.3",
    "winston": "^3.17.0"
  }
}
