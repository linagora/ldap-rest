{
  "name": "@ldap-rest/browser",
  "version": "3.0.0",
  "description": "LDAP-Rest browser libraries",
  "homepage": "https://github.com/linagora/ldap-rest",
  "bugs": {
    "url": "https://github.com/linagora/ldap-rest/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linagora/ldap-rest.git",
    "directory": "packages/browser"
  },
  "license": "AGPL-3.0",
  "author": "Xavier Guimard <xguimard@linagora.com>",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/shared/index.ts",
      "types": "./dist/shared/index.d.ts",
